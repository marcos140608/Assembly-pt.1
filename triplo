.data
msg: .asciiz "Digite um numero: "
res: .asciiz "Resultado: "

.text
main:
    li   $v0, 4
    la   $a0, msg
    syscall
    li   $v0, 5
    syscall
    move $t0, $v0

    bgtz $t0, positivo
    bltz $t0, negativo
    move $t1, $t0          # zero: fica zero
    j    imprime

positivo:
    li   $t2, 2
    mul  $t1, $t0, $t2
    j    imprime

negativo:
    li   $t2, 3
    mul  $t1, $t0, $t2

imprime:
    li   $v0, 4
    la   $a0, res
    syscall
    li   $v0, 1
    move $a0, $t1
    syscall
    li   $v0, 10
    syscall
